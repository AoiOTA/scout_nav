<!-- filepath: src/scout_nav/launch/scout_gmapping.launch -->
<!-- ====================================================================== -->
<!-- scout_gmapping.launch — 基于 Gmapping 的 2D SLAM 实时建图                -->
<!--                                                                         -->
<!-- Gmapping (GMapping) 核心原理：                                          -->
<!--   基于 Rao-Blackwellized 粒子滤波器 (RBPF) 的 2D SLAM 算法             -->
<!--   每个粒子独立维护一份栅格地图副本 + 一个机器人位姿估计                  -->
<!--   当新的激光扫描到达时：                                                -->
<!--     1. 运动模型预测：根据里程计增量预测每个粒子的新位姿                  -->
<!--     2. 扫描匹配优化：用梯度下降将预测位姿与地图对齐                      -->
<!--     3. 权重评估：计算每个粒子的似然权重                                  -->
<!--     4. 重采样：淘汰低权重粒子，复制高权重粒子                            -->
<!--     5. 地图更新：用优化后的位姿将扫描数据融入各粒子的地图中              -->
<!--                                                                         -->
<!-- TF 依赖链（Gmapping 必需）：                                            -->
<!--   odom → base_link（底盘驱动发布）                                      -->
<!--   base_link → velodyne（静态 TF 发布）                                  -->
<!-- Gmapping 自身发布：map → odom（闭环修正）                                -->
<!--                                                                         -->
<!-- 话题依赖：                                                               -->
<!--   /scan (sensor_msgs/LaserScan): 来自 pointcloud_to_laserscan           -->
<!--   /odom (nav_msgs/Odometry): 来自底盘驱动                               -->
<!-- ====================================================================== -->
<launch>

    <!-- ================================================================== -->
    <!-- [参数] use_sim_time                                                 -->
    <!-- 实车建图: false; Rosbag 离线回放建图: true                           -->
    <!-- ================================================================== -->
    <arg name="use_sim_time" default="false" />

    <!-- ================================================================== -->
    <!-- [模块 1] 硬件底层全栈拉起                                            -->
    <!-- ================================================================== -->
    <!-- <include file="$(find scout_nav)/launch/scout_bringup.launch">
        <arg name="use_sim_time" value="$(arg use_sim_time)" />
    </include> -->

    <!-- ================================================================== -->
    <!-- [模块 2] 3D 点云降维为 2D LaserScan                                  -->
    <!-- ================================================================== -->
    <!-- <include file="$(find scout_nav)/launch/scout_lidar_process.launch" /> -->

    <!-- ================================================================== -->
    <!-- [模块 3] Gmapping SLAM 节点                                          -->
    <!--                                                                     -->
    <!-- 输入：/scan + TF(odom→base_link)                                    -->
    <!-- 输出：/map (nav_msgs/OccupancyGrid) + TF(map→odom)                  -->
    <!-- ================================================================== -->
    <node name="slam_gmapping"
          pkg="gmapping"
          type="slam_gmapping"
          output="screen">

        <!-- ============ 坐标系配置 ============ -->

        <!-- base_frame: 机器人本体坐标系 -->
        <!-- ⚠️ 严格设为 base_link（不是 base_footprint！） -->
        <!-- base_footprint 仅在标定环境中存在，生产环境中已被废弃 -->
        <param name="base_frame"           value="base_link" />

        <!-- odom_frame: 里程计坐标系 -->
        <param name="odom_frame"           value="odom" />

        <!-- map_frame: 地图坐标系 -->
        <param name="map_frame"            value="map" />

        <!-- ============ 地图更新参数 ============ -->

        <!-- map_update_interval: 地图更新间隔（秒） -->
        <!-- 每 2 秒将最新的扫描匹配结果融入地图 -->
        <!-- 值越小更新越频繁，CPU 开销越大 -->
        <param name="map_update_interval"  value="2.0" />

        <!-- ============ 激光参数 ============ -->

        <!-- maxUrange: 激光的最大可用距离（米） -->
        <!-- 超过此距离的激光点不参与扫描匹配 -->
        <!-- 25m: 略小于降维时的 range_max=30m，排除远处精度差的点 -->
        <param name="maxUrange"            value="25.0" />

        <!-- maxRange: 激光的最大物理测距（米） -->
        <!-- 超过此值的测量值被完全忽略 -->
        <param name="maxRange"             value="30.0" />

        <!-- ============ 扫描匹配优化参数 ============ -->

        <!-- sigma: 激光端点的高斯噪声标准差（栅格单位） -->
        <!-- VLP-16 精度 ±3cm，0.05 是合理的噪声模型 -->
        <param name="sigma"                value="0.05" />

        <!-- kernelSize: 搜索对应关系的核大小（栅格单位） -->
        <!-- 1: 在最近邻 1 格范围内搜索对应点 -->
        <param name="kernelSize"           value="1" />

        <!-- lstep: 扫描匹配中平移方向的梯度下降步长（米） -->
        <!-- 0.05: 每步尝试移动 5cm 寻找最佳对齐 -->
        <param name="lstep"                value="0.05" />

        <!-- astep: 扫描匹配中旋转方向的梯度下降步长（弧度） -->
        <!-- 0.05 rad ≈ 2.86°: 每步尝试旋转约 3° -->
        <param name="astep"                value="0.05" />

        <!-- iterations: 扫描匹配梯度下降的最大迭代次数 -->
        <!-- 5: 通常 3~5 次即可收敛 -->
        <param name="iterations"           value="5" />

        <!-- lsigma: 似然计算中激光模型的标准差 -->
        <param name="lsigma"               value="0.075" />

        <!-- ogain: 似然评估的增益/平滑因子 -->
        <!-- 值越大，对匹配差的粒子惩罚越温和 -->
        <param name="ogain"                value="3.0" />

        <!-- lskip: 每隔 lskip 个激光束取一个进行匹配 -->
        <!-- 0: 使用全部激光束（VLP-16 降维后角分辨率合理） -->
        <param name="lskip"                value="0" />

        <!-- ============ 运动模型噪声参数 ============ -->
        <!-- 描述里程计的不确定性 -->
        <!-- ⚠️ Scout Mini 是滑移转向底盘，旋转时四轮侧滑严重 -->
        <!-- 旋转噪声必须比普通差速底盘（典型 0.01）显著增大 -->

        <!-- srr: 因平移运动产生的平移噪声 (m/m) -->
        <!-- 直线走 1m 产生约 1cm 的平移随机误差 -->
        <param name="srr"                  value="0.01" />

        <!-- srt: 因平移运动产生的旋转噪声 (rad/m) -->
        <!-- 直线走 1m 产生约 0.02rad 的旋转随机误差 -->
        <param name="srt"                  value="0.02" />

        <!-- str: 因旋转运动产生的平移噪声 (m/rad) -->
        <!-- 原地旋转 1rad 产生约 0.01m 的平移随机误差 -->
        <param name="str"                  value="0.01" />

        <!-- stt: 因旋转运动产生的旋转噪声 (rad/rad) -->
        <!-- ⚠️ 滑移转向底盘旋转时轮子严重侧滑 -->
        <!-- 0.02: 比普通差速底盘 (0.01) 大一倍 -->
        <param name="stt"                  value="0.02" />

        <!-- ============ 更新触发阈值 ============ -->
        <!-- 只有当机器人移动超过阈值时，才触发一次扫描匹配 -->

        <!-- linearUpdate: 线性移动阈值（米） -->
        <!-- 0.3m: 移动 30cm 才更新一次（节省 CPU） -->
        <!-- ⚠️ A/B Test 调参关键：减小此值可增加更新频率，提高建图精度 -->
        <!--    但 CPU 开销成倍增加，需根据你的电脑性能权衡 -->
        <param name="linearUpdate"         value="0.15" />

        <!-- angularUpdate: 角度旋转阈值（弧度） -->
        <!-- 0.3 rad ≈ 17°: 旋转约 17° 才更新一次 -->
        <param name="angularUpdate"        value="0.15" />

        <!-- temporalUpdate: 时���阈值（秒） -->
        <!-- -1.0: 禁用基于时间的强制更新 -->
        <param name="temporalUpdate"       value="-1.0" />

        <!-- ============ 粒子滤波参数 ============ -->

        <!-- particles: 粒子数量 -->
        <!-- 30: 中等规模，适合单机 CPU 性能 -->
        <!-- ⚠️ A/B Test 调参关键：增加粒子数可提高建图鲁棒性 -->
        <!--    但内存和 CPU 线性增长（每个粒子独立维护完整地图） -->
        <param name="particles"            value="50" />

        <!-- resampleThreshold: 有效粒子比 (N_eff/N) 低于此值时触发重采样 -->
        <!-- 0.5: 当有效粒子低于总数的一半时重采样 -->
        <param name="resampleThreshold"    value="0.5" />

        <!-- ============ 地图分辨率 ============ -->

        <!-- delta: 栅格分辨率（米/像素） -->
        <!-- 0.05: 每像素 5cm，足够精细 -->
        <param name="delta"                value="0.05" />

        <!-- ============ 似然场采样参数 ============ -->
        <param name="llsamplerange"        value="0.01" />
        <param name="llsamplestep"         value="0.01" />
        <param name="lasamplerange"        value="0.005" />
        <param name="lasamplestep"         value="0.005" />

        <!-- ============ 扫描匹配质量门槛 ============ -->

        <!-- minimumScore: 扫描匹配的最低可接受得分 -->
        <!-- 低于此得分的匹配结果会被拒绝（防止错误匹配导致地图撕裂） -->
        <!-- 200: 初始偏宽松，如出现"地图撕裂"请增至 300~400 -->
        <param name="minimumScore"         value="300" />

    </node>

</launch>