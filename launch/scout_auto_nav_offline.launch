<!-- filepath: src/scout_nav/launch/scout_auto_nav_offline.launch -->
<!-- ====================================================================== -->
<!-- scout_auto_nav_offline.launch — 离线一键调参启动 (★ Rosbag 雕刻专用 ★)  -->
<!--                                                                         -->
<!-- ⚠️ 启动前请确保已执行: rosparam set /use_sim_time true                     -->
<!-- 用法：                                                                   -->
<!--   roslaunch scout_nav scout_auto_nav_offline.launch                     -->
<!--   新开终端：rosbag play -clock scout_mapping_data.bag -pause             -->
<!-- ====================================================================== -->
<launch>

    <arg name="planner"  default="teb" />
    <arg name="map_file" default="$(find scout_nav)/maps/lab_map.yaml" />

    <!-- 导航核心栈离线版（无底层驱动，依赖 Bag 提供 TF 和 Scan） -->
    <include file="$(find scout_nav)/launch/scout_navigation_offline.launch">
        <arg name="planner"  value="$(arg planner)" />
        <arg name="map_file" value="$(arg map_file)" />
    </include>

    <!-- RViz（加载保存好的配置文件） -->
    <node name="rviz"
          pkg="rviz"
          type="rviz"
          args="-d $(find scout_nav)/rviz/scout_nav.rviz"
          output="screen" />

</launch>