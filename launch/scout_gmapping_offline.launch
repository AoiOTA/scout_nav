<!-- filepath: src/scout_nav/launch/scout_gmapping_offline.launch -->
<!-- ====================================================================== -->
<!-- scout_gmapping_offline.launch — Rosbag 离线调参 (★ 室内平滑地面+极度侧滑专版 ★) -->
<!-- ====================================================================== -->
<launch>

    <!-- 强制仿真时间，必须依赖 rosbag play -clock -->
    <param name="/use_sim_time" value="true" />

    <!-- 仅加载模型供 RViz 渲染，不启动 state_publisher -->
    <!-- <param name="robot_description"
           command="$(find xacro)/xacro '$(find scout_description)/urdf/scout_mini.urdf.xacro'" /> -->

    <!-- ================================================================== -->
    <!-- [纯净版] Gmapping SLAM 节点                                          -->
    <!-- ================================================================== -->
     <node name="slam_gmapping"
          pkg="gmapping"
          type="slam_gmapping"
          output="screen">

        <!-- ============ 坐标系配置 ============ -->

        <!-- base_frame: 机器人本体坐标系 -->
        <!-- ⚠️ 严格设为 base_link（不是 base_footprint！） -->
        <!-- base_footprint 仅在标定环境中存在，生产环境中已被彻底废弃 -->
        <param name="base_frame"           value="base_link" />

        <!-- odom_frame: 里程计坐标系 -->
        <param name="odom_frame"           value="odom" />

        <!-- map_frame: 地图坐标系 -->
        <param name="map_frame"            value="map" />

        <!-- ============ 地图更新参数 ============ -->

        <!-- map_update_interval: 地图更新间隔（秒） -->
        <!-- 每 2.0 秒将最新的扫描匹配结果融入地图网格中 -->
        <param name="map_update_interval"  value="2.0" />

        <!-- ============ 激光参数 ============ -->

        <!-- maxUrange: 激光的最大可用距离（米） -->
        <!-- 超过此距离的激光点不参与扫描匹配 -->
        <!-- 25m: 略小于降维时的 range_max=30m，排除远处精度差的点 -->
        <param name="maxUrange"            value="25.0" />

        <!-- maxRange: 激光的最大物理测距（米） -->
        <!-- 超过此值的测量值被完全忽略 -->
        <param name="maxRange"             value="30.0" />

        <!-- ============ 扫描匹配优化参数 ============ -->

        <!-- sigma: 激光端点的高斯噪声标准差（栅格单位） -->
        <!-- VLP-16 精度 ±3cm，0.05 是非常合理的噪声模型 -->
        <param name="sigma"                value="0.05" />

        <!-- kernelSize: 搜索对应关系的核大小（栅格单位） -->
        <param name="kernelSize"           value="1" />

        <!-- lstep: 扫描匹配中平移方向的梯度下降步长（米） -->
        <!-- 0.05: 每步尝试移动 5cm 寻找最佳对齐 -->
        <param name="lstep"                value="0.05" />

        <!-- astep: 扫描匹配中旋转方向的梯度下降步长（弧度） -->
        <!-- 0.05 rad ≈ 2.86°: 每步尝试旋转约 3° -->
        <param name="astep"                value="0.05" />

        <!-- iterations: 扫描匹配梯度下降的最大迭代次数 -->
        <param name="iterations"           value="5" />

        <!-- lsigma: 似然计算中激光模型的标准差 -->
        <param name="lsigma"               value="0.075" />

        <!-- ogain: 似然评估的增益/平滑因子 -->
        <param name="ogain"                value="3.0" />

        <!-- lskip: 每隔 lskip 个激光束取一个进行匹配 -->
        <!-- 0: 使用全部激光束（VLP-16 降维后角分辨率合理，不跳过） -->
        <param name="lskip"                value="0" />

        <!-- ============ 运动模型噪声参数 ============ -->
        <!-- 描述里程计的不确定性 -->
        <!-- ⚠️ Scout Mini 是滑移转向底盘，旋转时四轮侧滑严重 -->
        <!-- 旋转噪声必须比普通差速底盘（典型 0.01）显著增大 -->

        <!-- srr: 因平移运动产生的平移噪声 (m/m) -->
        <param name="srr"                  value="0.01" />

        <!-- srt: 因平移运动产生的旋转噪声 (rad/m) -->
        <param name="srt"                  value="0.01" />

        <!-- str: 因旋转运动产生的平移噪声 (m/rad) -->
        <param name="str"                  value="0.3" />

        <!-- stt: 因旋转运动产生的旋转噪声 (rad/rad) -->
        <!-- ⚠️ 滑移转向底盘旋转时轮子严重侧滑，此处设为 0.1（比差速底盘翻倍） -->
        <param name="stt"                  value="0.3" />

        <!-- ============ [★ 已优化] 更新触发阈值 ============ -->
        <!-- 只有当机器人移动超过此阈值时，才触发一次扫描匹配。 -->
        <!-- 阈值越小，更新频率越高，轨迹越丝滑，但 CPU 负载随之增加。 -->

        <!-- linearUpdate: 线性移动阈值（米） -->
        <!-- ★ 由 0.3 优化至 0.15：移动 15cm 即更新一次，大幅提升建图精细度 -->
        <param name="linearUpdate"         value="0.15" />

        <!-- angularUpdate: 角度旋转阈值（弧度） -->
        <!-- ★ 由 0.3 优化至 0.15：转动约 8.5° 即更新一次，有效应对转弯时的地图扭曲 -->
        <param name="angularUpdate"        value="0.15" />

        <!-- temporalUpdate: 时间阈值（秒） -->
        <!-- -1.0: 禁用基于时间的强制更新，纯粹靠移动距离触发 -->
        <param name="temporalUpdate"       value="-1.0" />

        <!-- ============[★ 已优化] 粒子滤波参数 ============ -->

        <!-- particles: 粒子数量 -->
        <!-- ★ 由 30 提升至 50：更多的粒子意味着更大的解算搜索空间， -->
        <!-- 大幅降低因打滑或急转弯导致的粒子群收敛失败率，提升系统鲁棒性。 -->
        <param name="particles"            value="60" />

        <!-- resampleThreshold: 有效粒子比 (N_eff/N) 低于此值时触发重采样 -->
        <!-- 0.5: 当有效粒子低于总数的一半时重采样 -->
        <param name="resampleThreshold"    value="0.5" />

        <!-- ============ 地图分辨率 ============ -->

        <!-- delta: 栅格分辨率（米/像素） -->
        <!-- 0.05: 每像素 5cm，足够精细 -->
        <param name="delta"                value="0.05" />

        <!-- ============ 似然场采样参数 ============ -->
        <param name="llsamplerange"        value="0.01" />
        <param name="llsamplestep"         value="0.01" />
        <param name="lasamplerange"        value="0.005" />
        <param name="lasamplestep"         value="0.005" />

        <!-- ============ [★ 已优化] 扫描匹配质量门槛 ============ -->

        <!-- minimumScore: 扫描匹配的最低可接受得分 -->
        <!-- ★ 由 200 提升至 300：这是防地图撕裂的最核心护城河！ -->
        <!-- 当底盘走在长直走廊（环境高度对称）时，容易发生错误匹配。 -->
        <!-- 提高及格线后，Gmapping 会果断拒绝低分匹配，转而绝对信任里程计，从而保证地图平直。 -->
        <param name="minimumScore"         value="350" />


    </node>

</launch>