<!-- filepath: src/scout_nav/launch/scout_auto_nav.launch -->
<!-- ====================================================================== -->
<!-- scout_auto_nav.launch (★ 实车生产部署专用 ★)                          -->
<!--                                                                         -->
<!-- 核心用途：全功能开启，包含 move_base 自动脱困行为，用于最终的自主导航任务。   -->
<!-- 用法：                                                                   -->
<!--   roslaunch scout_nav scout_auto_nav.launch                 # 默认 TEB  -->
<!--   roslaunch scout_nav scout_auto_nav.launch planner:=dwa    # 切换 DWA  -->
<!-- ====================================================================== -->
<launch>

    <arg name="planner"  default="teb" />
    <!-- 默认地图指向我们 Phase 4 实际建好的 lab_map.yaml -->
    <arg name="map_file" default="$(find scout_nav)/maps/lab_map.yaml" />

    <!-- 导航核心栈生产版（实车硬件 + 降维 + 地图 + 实车AMCL + 开启脱困的move_base） -->
    <include file="$(find scout_nav)/launch/scout_navigation.launch">
        <arg name="planner"  value="$(arg planner)" />
        <arg name="map_file" value="$(arg map_file)" />
    </include>

    <!-- RViz（加载保存好的配置文件，首次启动可能为空白需手动配置） -->
    <node name="rviz"
          pkg="rviz"
          type="rviz"
          args="-d $(find scout_nav)/rviz/scout_nav.rviz"
          output="screen" />

</launch>