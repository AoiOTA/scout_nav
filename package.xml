<?xml version="1.0"?>
<!-- filepath: src/scout_nav/package.xml -->
<package format="2">
  <name>scout_nav</name>
  <version>0.1.0</version>
  <description>
    Scout Mini autonomous navigation: dual-stage zero-trust extrinsic calibration,
    SLAM mapping, AMCL localization, DWA/TEB navigation.
  </description>
  <maintainer email="22320219@hdu.edu.cn">AoiOTA</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- 构建依赖 -->
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>xacro</build_depend>
  <build_depend>robot_state_publisher</build_depend>
  <build_depend>joint_state_publisher</build_depend>
  <build_depend>dynamic_reconfigure</build_depend>
  <build_depend>pointcloud_to_laserscan</build_depend>

  <!-- 运行时依赖 -->
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>

  <!-- 导航栈运行时依赖 -->
  <exec_depend>gmapping</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>

</package>